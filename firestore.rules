rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read, write: if request.auth != null;
      match /chat/{msg} {
        allow read, create: if request.auth != null;
      }
    }
    match /results/{id} {
      allow read, create: if request.auth != null;
    }
    match /leases/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
